<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>Webi</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- The unit tests are their own project (tests/Webi.Tests). -->
    <Compile Remove="tests/**" />
    <!-- The settings page, served by src/Settings/SettingsServer.cs (travels inside the .dll, so inside the exe). -->
    <EmbeddedResource Include="src/Settings/settings.html" LogicalName="Webi.settings.html" />
  </ItemGroup>
</Project>
